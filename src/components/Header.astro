---
// src/components/Header.astro
---
<header>
    <nav>
        <a href="/" style="color: var(--accent-cyan);">
            <i class="bi bi-house-door-fill"></i> <b>INICIO</b>
        </a>
        <a href="/lugares">
            <i class="bi bi-geo-alt-fill"></i> <b>LUGARES</b>
        </a>
        <a href="/servicios">
            <i class="bi bi-ticket-perforated-fill"></i> <b>SERVICIOS</b>
        </a>
        <a href="/explorar">
            <i class="bi bi-compass-fill"></i> <b>EXPLORAR</b>
        </a>
        <a href="/sobrelapuna">
            <i class="bi bi-journal-text"></i> <b>SOBRE LA PUNA</b>
        </a>
        <a href="/galeria">
            <i class="bi bi-images"></i> <b>GALERIA</b>
        </a>
    </nav>
    <a href="/login" class="login-link">
        <i class="bi bi-person-fill"></i> <b>INICIAR SESIÓN</b>
    </a>
</header>

<style>
    header {
        width: 100%; height: 80px;
        background-color: rgba(11, 11, 11, 0.9);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--border-color);
        padding: 0 50px;
        display: flex; justify-content: space-between; align-items: center;
        position: fixed; top: 0; z-index: 1000;
    }
    header nav { display: flex; gap: 30px; }
    header a {
        text-decoration: none; color: var(--text-muted);
        font-family: 'Oswald', sans-serif; font-size: 0.9rem;
        font-weight: 500; display: flex; align-items: center; gap: 8px;
        text-transform: uppercase; letter-spacing: 1.5px;
        position: relative; transition: 0.3s;
    }
    header nav a:hover { color: var(--accent-cyan); text-shadow: 0 0 8px var(--accent-glow); }
    header nav a::after {
        content: ''; position: absolute; bottom: -5px; left: 0;
        width: 0; height: 2px; background: var(--accent-cyan); transition: width 0.3s ease;
    }
    header nav a:hover::after { width: 100%; }
    .login-link {
        border: 1px solid var(--border-color); padding: 8px 20px; border-radius: 4px;
        background: rgba(255,255,255,0.03);
    }
    .login-link:hover {
        background: var(--accent-cyan); color: #000 !important;
        border-color: var(--accent-cyan); box-shadow: 0 0 15px var(--accent-glow);
    }
    @media screen and (max-width: 678px) {
        header { padding: 0 20px; }
        header nav a span { display: none; } 
    }
</style>